{
  "manifest_version": 3,
  "name": "Year 12,000",
  "version": "1.0.0",
  "description": "Shows every date on the web in the Human Era: 2026 becomes 12026.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Year 12,000",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lexicon.js", "dates.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
